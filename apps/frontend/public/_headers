# Cloudflare Pages caching rules.
# index.html must always be revalidated, otherwise the browser keeps an old
# copy that references hashed JS chunks from a previous build (those chunks no
# longer exist -> 404 -> blank screen).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Hashed build artifacts (outputHashing: "all") never change content for a
# given name, so they can be cached forever.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# The Angular service worker and its manifest are NOT content-hashed — they
# must be revalidated on every load or clients get stuck on old builds.
# (Later rules override the /*.js wildcard above.)
/ngsw-worker.js
  Cache-Control: no-cache
/ngsw.json
  Cache-Control: no-cache
/safety-worker.js
  Cache-Control: no-cache
/worker-basic.min.js
  Cache-Control: no-cache
