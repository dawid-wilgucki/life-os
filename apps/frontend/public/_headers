# Cloudflare Pages caching rules.
# index.html must always be revalidated, otherwise the browser keeps an old
# copy that references hashed JS chunks from a previous build (those chunks no
# longer exist -> 404 -> blank screen).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Hashed build artifacts (outputHashing: "all") never change content for a
# given name, so they can be cached forever.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
