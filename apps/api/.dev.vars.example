# Copy to apps/api/.dev.vars (gitignored) for local `wrangler dev`.
# These mirror the production secrets set via `wrangler secret put`.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-32-byte-hex-secret
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
# Google AI Studio — aistudio.google.com → Get API key
GEMINI_API_KEY=AIzaSy...
# Google Calendar IDs for parent shared calendars (Settings → Calendar ID in Google Calendar)
PARENT_MOM_CALENDAR_ID=mama@group.calendar.google.com
PARENT_DAD_CALENDAR_ID=tata@group.calendar.google.com
